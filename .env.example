# Copia este archivo a .env y ajusta los valores.
# Local: tras `npm run db:start` en fidelizacionApi, copia la URL y la clave
# `anon` que muestra `npm run db:status` (por defecto http://127.0.0.1:54321).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<CLAVE_ANON_LOCAL>

# Identidad provisional configurable
VITE_BRAND_NAME=Loopoint
VITE_BRAND_TAGLINE=Loopoints por tus compras

# Dominio público para los QR y enlaces de invitación de Loopoint.
# En local conviene dejar el dominio publicado: la base de datos es la misma y
# los QR se prueban en línea. Si se omite, se usa https://fidelizacion01.vercel.app.
VITE_PUBLIC_APP_URL=https://fidelizacion01.vercel.app
